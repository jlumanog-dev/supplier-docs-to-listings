    {
      "parameters": {
        "jsCode": "const TOL_DOWN = 0.15;   // drops are suspicious\nconst TOL_UP   = 0.40;   // increases are normal business\nconst MIN_PESO = 100;    // ignore noise on cheap items\n\nconst row = $('Process product entry one at a time').first().json;\nlet price = 0;\nif($input.first().json.regular_price){\n  price = parseInt($input.first().json.regular_price)\n}else{\n  price = $input.first().json.srp\n}\nconst existing = parseFloat($('fetch given SKU').first().json.body[0].price || 0);\nconst incoming = price;\n\nconst delta    = incoming - existing;\nconst variance = existing > 0 ? Math.abs(delta) / existing : 0;\nconst dir      = delta < 0 ? 'down' : 'up';\nconst limit    = dir === 'down' ? TOL_DOWN : TOL_UP;\n\nconst blocked  = variance > limit && Math.abs(delta) > MIN_PESO;\n\nreturn [{ json: {\n  ...row,\n  woo_id: $input.first().json.id,\n  existing_price: existing,\n  variance_pct: Math.round(variance * 1000) / 10,\n  direction: dir,\n  blocked,\n  notes: blocked\n    ? `price ${dir} ${Math.round(variance*100)}%: ${existing} → ${incoming}`\n    : row.notes,\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        32
      ],
      "id": "e797a1d4-e353-46d1-a7b6-ea1315847802",
