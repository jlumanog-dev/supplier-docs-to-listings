      "parameters": {
        "jsCode": "const r = $('Process product entry one at a time').first().json;\nconst specs = JSON.parse(r.specs_json || '[]');\n\nreturn [{ json: {\n  name: r.name,\n  sku: r.sku,\n  source_id: r.source_id,\n  type: 'simple',\n  status: 'draft',\n  catalog_visibility: 'visible',\n  regular_price: String(r.regular_price),\n  srp: r.srp,\n  short_description: r.short_description || '',\n  description: r.description || '',\n  manage_stock: r.stock_qty !== '' && r.stock_qty !== null,\n  stock_quantity: Number(r.stock_qty) || 0,\n  categories: r.category_ids,\n  attributes: specs.map((s, i) => ({\n    name: s.key, position: i, visible: true,\n    variation: false, options: [s.value],\n  })),\n  meta_data: [\n    { key: '_supplier_cost',  value: String(r.supplier_price) },\n    { key: '_source_file',    value: r.source_file },\n    { key: '_run_id',         value: r.run_id },\n  ],\n}}];"
      },
